{
  "schemaVersion": 1,
  "id": "c-semifinals-selection-statements",
  "name": "C Semifinals: Selection Statements",
  "version": "1",
  "description": "A persistent 90-minute C semifinals session focused on selection statements and their prerequisite operator, output, expression, tracing, simulation, and ordering skills.",
  "session": {
    "timing": {
      "enabled": true,
      "minutes": 90
    },
    "persistence": {
      "enabled": true
    }
  },
  "categories": [
    {
      "id": "semifinals-token-qualification",
      "name": "Token Qualification",
      "enabled": true,
      "profileIds": [
        "semifinals-operator-qualification"
      ]
    },
    {
      "id": "semifinals-trace-output",
      "name": "Trace Output Commands",
      "enabled": true,
      "profileIds": [
        "semifinals-trace-output-only",
        "semifinals-trace-input-output"
      ]
    },
    {
      "id": "semifinals-expression-evaluator",
      "name": "Relational and Boolean Expressions",
      "enabled": true,
      "profileIds": [
        "semifinals-relational-expressions",
        "semifinals-boolean-expressions"
      ]
    },
    {
      "id": "semifinals-trace-selection",
      "name": "Trace Selection Statements",
      "enabled": true,
      "profileIds": [
        "semifinals-trace-if",
        "semifinals-trace-if-else",
        "semifinals-trace-else-if",
        "semifinals-trace-switch",
        "semifinals-trace-combination"
      ]
    },
    {
      "id": "semifinals-simulate-selection",
      "name": "Simulate Selection Statements",
      "enabled": true,
      "profileIds": [
        "semifinals-simulate-if",
        "semifinals-simulate-if-else",
        "semifinals-simulate-else-if",
        "semifinals-simulate-switch",
        "semifinals-simulate-switch-if"
      ]
    },
    {
      "id": "semifinals-order-selection",
      "name": "Order Selection Statements",
      "enabled": true,
      "profileIds": [
        "semifinals-order-values",
        "semifinals-order-if",
        "semifinals-order-if-else",
        "semifinals-order-else-if",
        "semifinals-order-switch"
      ]
    }
  ],
  "profiles": [
    {
      "enabled": true,
      "meta": {
        "id": "semifinals-operator-qualification",
        "name": "Operator Qualification",
        "description": "Classify 20 C tokens as arithmetic, assignment, relational, Boolean, or invalid."
      },
      "scoring": {
        "itemCount": 1,
        "pointsPerItem": 20
      },
      "activity": {
        "kind": "falling-token-sort",
        "instructions": "Sort each token into its C operator family or Invalid. Keyboard: select a token, then choose a bucket.",
        "buckets": [
          {
            "id": "arithmetic",
            "category": "arithmetic-operator",
            "region": "bottom",
            "order": 1
          },
          {
            "id": "assignment",
            "category": "assignment-operator",
            "region": "bottom",
            "order": 2
          },
          {
            "id": "relational",
            "category": "relational-operator",
            "region": "bottom",
            "order": 3
          },
          {
            "id": "boolean",
            "category": "boolean-operator",
            "region": "bottom",
            "order": 4
          },
          {
            "id": "invalid",
            "category": "operator-distractor",
            "region": "bottom",
            "order": 5
          }
        ],
        "dropArea": {
          "visibleTokens": 20,
          "landingBehavior": "pass-through"
        },
        "generator": {
          "capability": "canonical-token-pools",
          "tokenPools": {
            "arithmetic-operator": [
              "+",
              "-",
              "*",
              "/",
              "%"
            ],
            "assignment-operator": [
              "=",
              "+=",
              "-=",
              "*=",
              "/=",
              "%="
            ],
            "relational-operator": [
              "<",
              ">",
              "<=",
              ">=",
              "==",
              "!="
            ],
            "boolean-operator": [
              "&&",
              "||",
              "!"
            ],
            "operator-distractor": [
              "=>",
              "=<",
              "and",
              "or",
              "<>",
              "**",
              "value",
              "42",
              ";",
              ","
            ]
          },
          "policies": {
            "practice": {
              "totalTokens": {
                "exact": 20
              },
              "counts": {
                "arithmetic-operator": {
                  "exact": 4
                },
                "assignment-operator": {
                  "exact": 4
                },
                "relational-operator": {
                  "exact": 4
                },
                "boolean-operator": {
                  "exact": 3
                },
                "operator-distractor": {
                  "exact": 5
                }
              },
              "shuffle": true
            },
            "exam": {
              "totalTokens": {
                "exact": 20
              },
              "counts": {
                "arithmetic-operator": {
                  "exact": 4
                },
                "assignment-operator": {
                  "exact": 4
                },
                "relational-operator": {
                  "exact": 4
                },
                "boolean-operator": {
                  "exact": 3
                },
                "operator-distractor": {
                  "exact": 5
                }
              },
              "shuffle": true
            }
          }
        },
        "assessment": {
          "action": "SORT_TOKEN",
          "cardinality": "per-token",
          "scoreAttempt": "first",
          "completion": "all-tokens-placed"
        },
        "response": {
          "policies": {
            "practice": {
              "incorrectPlacement": "accept"
            },
            "exam": {
              "incorrectPlacement": "accept"
            }
          }
        },
        "feedback": {
        "practice": "deferred",
          "exam": "deferred-until-timeout"
        }
      },
      "behavior": {
        "interactionMode": "guided",
        "allowUndo": true,
        "allowRetry": true,
        "allowReviewFlags": true,
        "showNeutralGuidance": false,
        "showScores": true,
        "feedbackRelease": "after-timeout",
        "lockItemAfterCheck": false,
        "showCorrectSolution": false,
        "manualResponses": {
          "mode": "profile",
          "namedValueRate": 50,
          "operatorRate": 50
        }
      }
    },
    {
      "enabled": true,
